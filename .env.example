# Twilio credentials — Twilio Console dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model provider — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Twilio senders. TWILIO_WHATSAPP_NUMBER must include the "whatsapp:" prefix.
TWILIO_SMS_NUMBER=+15551234567
TWILIO_WHATSAPP_NUMBER=whatsapp:+15551234567

# Public HTTPS origin Twilio calls your webhook on. Set to your ngrok URL locally,
# or your Vercel deployment URL in production. Used verbatim in signature verification.
PUBLIC_BASE_URL=

# Twilio resources you provisioned via the curl calls in the blog post.
MEMORY_STORE_ID=mem_store_xxxxxxxx
ORCHESTRATOR_CONFIG_ID=conv_configuration_xxxxxxxx
